{
  "name": "jamanot-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mobile:build": "BUILD_TARGET=native next build && npx cap sync android",
    "mobile:android": "BUILD_TARGET=native next build && npx cap sync android && npx cap open android",
    "mobile:ios": "BUILD_TARGET=native next build && npx cap sync ios",
    "cap:sync": "npx cap sync",
    "cap:doctor": "npx cap doctor",
    "test:geofence": "node scripts/test-geofence.mjs",
    "mobile:apk": "npm run mobile:build && cd android && ./gradlew assembleDebug && echo \"\\nAPK: $(cd .. && pwd)/android/app/build/outputs/apk/debug/app-debug.apk\"",
    "mobile:install": "npm run mobile:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "firebase": "^10.12.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
