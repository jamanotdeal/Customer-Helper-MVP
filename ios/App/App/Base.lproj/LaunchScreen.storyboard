<?xml version="1.0" encoding="UTF-8"?>
<!-- White, with the splash art (logo, name, slogan) at 192×192 pt in the centre:
     the same image, size and place as Android's launch splash and the in-app
     AppSplash (scripts/render-splash-art.mjs). The SplashScreen plugin builds the
     splash it holds until the page is ready from this storyboard as well. -->
