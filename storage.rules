rules_version = '2';

// Photos shown in the app: products, shops, home slides, store applications,
// push notifications, and custom modals.
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can view them: visitors browse without signing in.
    match /{folder}/{file} {
      allow read: if folder in ['products', 'shops', 'slides', 'applications', 'notifications', 'migrated', 'custom-modals'];

      // Uploads: signed in (or custom-modals), an image, under 5 MB.
      allow create: if (request.auth != null || folder == 'custom-modals')
        && folder in ['products', 'shops', 'slides', 'applications', 'notifications', 'custom-modals']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
